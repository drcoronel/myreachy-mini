# Copy this to .env and fill in your values

# Reachy Mini daemon (already running on the robot)
REACHY_HOST=reachy-mini.local   # mDNS hostname or IP address
REACHY_PORT=8000                 # daemon HTTP/WebSocket port

# Google Gemini
GOOGLE_API_KEY=your_key_here

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llava:13b

# AI services backend (this repo's FastAPI, not the daemon)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8001

# Conversation app (CONV_ prefix)
CONV_LLM_MODEL=llama3.2:3b
CONV_STT_MODEL=large-v3-turbo
CONV_STT_LANGUAGE=en
CONV_TTS_VOICE=af_heart
CONV_VAD_THRESHOLD=0.5
CONV_VAD_SILENCE_MS=1200
CONV_PERSONALITY=friendly
CONV_SIM=false
