# Copy this to .env and fill in your values

# Reachy Mini connection
REACHY_HOST=reachy.local      # mDNS hostname or IP address
REACHY_PORT=50051              # gRPC port (default)

# Google Gemini
GOOGLE_API_KEY=your_key_here

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llava:13b   # default VLM model

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
